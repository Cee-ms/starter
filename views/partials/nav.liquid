{% comment %}A menu from Cee.ms → Navigation, rendered by the navigation tag in the layout.{% endcomment %}
<nav class="site-nav" aria-label="Main">
  <ul>
    {% for item in pages %}
      <li><a href="/{% if item.fullpath != 'home' %}{{ item.fullpath }}{% endif %}">{{ item.name }}</a></li>
    {% endfor %}
  </ul>
</nav>
