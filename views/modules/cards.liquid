{% comment %}
@name Cards
@field cards CONTRIBUTOR Cards
@field cards.text TEXTBOX Text
@field cards.link LINK Link
{% endcomment %}
<section class="mx-auto max-w-6xl px-4 py-12">
  {% if heading %}<h2 class="mb-8 text-3xl font-bold tracking-tight">{{ heading }}</h2>{% endif %}
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for card in cards %}
      <li class="overflow-hidden rounded-2xl border border-slate-200 [&_img]:aspect-[3/2] [&_img]:w-full [&_img]:object-cover">
        {% if card.image %}{% image card.image %}{% endif %}
        <div class="p-5">
          <h3 class="text-lg font-semibold">
            {% if card.link %}<a class="hover:text-accent" href="{{ card.link }}">{{ card.title }}</a>{% else %}{{ card.title }}{% endif %}
          </h3>
          {% if card.text %}<p class="mt-2 text-slate-600">{{ card.text }}</p>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
</section>
