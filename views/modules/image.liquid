{% comment %}
@name Image
@field caption TEXT Caption
{% endcomment %}
{% if image %}
  <figure class="mx-auto max-w-6xl px-4 py-12 [&_img]:w-full [&_img]:rounded-2xl">
    {% image image %}
    {% if caption %}<figcaption class="mt-3 text-sm text-slate-500">{{ caption }}</figcaption>{% endif %}
  </figure>
{% endif %}
