{% comment %}
@name Hero
@field intro TEXTBOX Introduction
@field button LINK Button link
@field button_label TEXT Button label
{% endcomment %}
<section class="hero{% if image %} hero--image{% endif %}">
  {% if image %}<div class="hero__image">{% image image %}</div>{% endif %}
  <div class="container hero__content">
    <h1>{{ heading }}</h1>
    {% if intro %}<p class="hero__intro">{{ intro }}</p>{% endif %}
    {% if button %}<a class="button" href="{{ button }}">{{ button_label | default: 'Find out more' }}</a>{% endif %}
  </div>
</section>
