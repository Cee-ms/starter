{% comment %}
@name Standard page
The page layout. The modules editors add go in the main region. Add more layouts to views/layouts/
(each becomes a template in Cee.ms), and more regions to a layout for other places modules can go.
{% endcomment %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ page.title | default: page.name }} | {{ site.name }}</title>
    {% if page.description %}<meta name="description" content="{{ page.description }}" />{% endif %}
    <link rel="stylesheet" href="/site.css" />
    {% structureddata %}
    {% socialmeta %}
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-900 antialiased">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a class="text-xl font-bold text-slate-900 no-underline" href="/">{{ site.name }}</a>
        {% navigation 'main' 'nav' %}
      </div>
    </header>
    <main class="flex-1">
      {% region main %}
    </main>
    <footer class="mt-12 border-t border-slate-200">
      <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-slate-500">&copy; {{ 'now' | date: '%Y' }} {{ site.name }}</div>
    </footer>
  </body>
</html>
